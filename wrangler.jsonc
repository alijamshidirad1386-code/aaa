{
  "$schema": "https://unpkg.com/wrangler@4.133.0/config-schema.json",
  "name": "petrapet",
  "main": "./worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxshop-db",
      "database_id": "ac370356-eb2a-4e21-8d88-fc750341388a"
    }
  ]
}
